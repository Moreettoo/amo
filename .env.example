# Publicas por desenho (vao ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Cloudflare Turnstile; em desenvolvimento, a chave de teste 1x00000000000000000000AA (sempre passa)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# So do servidor. Nunca com NEXT_PUBLIC_, nunca em log.
SUPABASE_PORTA=
SUPABASE_SECRET_KEY=
TAREFAS_SEGREDO=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# teste no desenvolvimento; sem a variavel, o servidor se comporta como producao e recusa a cotacao de exemplo
MERCADOPAGO_AMBIENTE=teste

# Uber Direct, so do servidor; nunca com NEXT_PUBLIC_.
# Enquanto a conta do Uber Direct nao existe, a cotacao e de exemplo.
# Identificador da conta (painel direct.uber.com, Management > Developer)
UBER_DIRECT_CUSTOMER_ID=
# Credencial OAuth da aplicacao (publica dentro do servidor)
UBER_DIRECT_CLIENT_ID=
# Segredo OAuth da aplicacao; tratar como senha
UBER_DIRECT_CLIENT_SECRET=
# Segredo para conferir a assinatura dos webhooks da Uber
UBER_DIRECT_WEBHOOK_SECRET=
# teste na conta de teste; sem a variavel o servidor se comporta como producao
UBER_DIRECT_AMBIENTE=teste
# JSON {"logradouro","numero","complemento","bairro","cidade","uf","cep","telefone"} da cozinha
COZINHA_ENDERECO=
